# ============================================================
# CAMBUS Connect — .gitignore
# ============================================================

# NOTE: Firebase web API keys are public by design.
# Security is enforced via Firestore Security Rules, not by hiding keys.
# See: https://firebase.google.com/docs/projects/api-keys

# --- Node / NPM ---
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
package-lock.json

# --- Environment files ---
.env
.env.local
.env.*.local

# --- OS files ---
.DS_Store
Thumbs.db
desktop.ini

# --- IDE / Editor ---
.vscode/
.idea/
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?

# --- Build output ---
dist/
build/

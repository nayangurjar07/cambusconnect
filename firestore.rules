rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // =========================================================================
    // AUTHORIZATION HELPERS
    // =========================================================================
    function isAuthenticated() {
      return request.auth != null && request.auth.uid != null;
    }

    function isOwnerOf(email) {
      return isAuthenticated() && (
        request.auth.token.email == email || 
        request.auth.token.email.lower() == email.lower()
      );
    }

    function userExists() {
      return request.auth != null && 
             request.auth.token != null &&
             request.auth.token.email != null &&
             (exists(/databases/$(database)/documents/users/$(request.auth.token.email)) ||
              exists(/databases/$(database)/documents/users/$(request.auth.token.email.lower())) ||
              exists(/databases/$(database)/documents/students/$(request.auth.token.email)) ||
              exists(/databases/$(database)/documents/students/$(request.auth.token.email.lower())));
    }

    function getUserData() {
      let email = request.auth.token.email;
      let emailLower = request.auth.token.email.lower();
      return exists(/databases/$(database)/documents/users/$(email)) 
        ? get(/databases/$(database)/documents/users/$(email)).data
        : (exists(/databases/$(database)/documents/users/$(emailLower))
          ? get(/databases/$(database)/documents/users/$(emailLower)).data
          : (exists(/databases/$(database)/documents/students/$(email))
            ? get(/databases/$(database)/documents/students/$(email)).data
            : get(/databases/$(database)/documents/students/$(emailLower)).data));
    }

    function isAdmin() {
      return userExists() && (getUserData().role in ['admin', 'superadmin', 'owner']);
    }

    function isDriverOrConductor() {
      return userExists() && (getUserData().role in ['driver', 'conductor']);
    }

    function isNotRevoked() {
      return !userExists() || (getUserData().role != 'revoked' && (!('status' in getUserData()) || getUserData().status != 'Terminated'));
    }

    function isAuthorizedUser() {
      return isAuthenticated() && isNotRevoked();
    }

    // =========================================================================
    // USERS COLLECTION
    // =========================================================================
    match /users/{email} {
      allow read: if isAuthenticated() && (
        isOwnerOf(email) || 
        request.auth.token.email.lower() == email.lower() || 
        isAdmin() || 
        isDriverOrConductor()
      );
      allow create: if isAdmin() || (
        isAuthenticated() && (
          isOwnerOf(email) || 
          request.auth.token.email.lower() == email.lower()
        ) &&
        (!('role' in request.resource.data) || request.resource.data.role == 'student') &&
        (!('status' in request.resource.data) || request.resource.data.status in ['Pending', 'Active'])
      );
      allow update: if isAdmin() || (
        isAuthenticated() && 
        (isOwnerOf(email) || request.auth.token.email.lower() == email.lower()) && 
        request.resource.data.role == resource.data.role &&
        (!('passValidity' in request.resource.data) || request.resource.data.passValidity == resource.data.passValidity) &&
        (!('status' in request.resource.data) || request.resource.data.status == resource.data.status) &&
        (!('assignedBusId' in request.resource.data) || request.resource.data.assignedBusId == resource.data.assignedBusId) &&
        (!('assignedRoute' in request.resource.data) || request.resource.data.assignedRoute == resource.data.assignedRoute) &&
        (!('busRoute' in request.resource.data) || request.resource.data.busRoute == resource.data.busRoute)
      );
      allow delete: if isAdmin();
    }

    // =========================================================================
    // STUDENTS COLLECTION
    // =========================================================================
    match /students/{studentId} {
      allow read: if isAuthenticated() && (
        isOwnerOf(studentId) || 
        request.auth.token.email.lower() == studentId.lower() || 
        isAdmin() ||
        isDriverOrConductor()
      );
      allow create, delete: if isAdmin();
      allow update: if isAdmin() || (
        isAuthenticated() && (
          isOwnerOf(studentId) || 
          request.auth.token.email.lower() == studentId.lower()
        ) &&
        (!('role' in request.resource.data) || request.resource.data.role == resource.data.role) &&
        (!('passValidity' in request.resource.data) || request.resource.data.passValidity == resource.data.passValidity) &&
        (!('status' in request.resource.data) || request.resource.data.status == resource.data.status)
      );
    }

    // =========================================================================
    // BOARDING LOGS (Atomic Anti-Passback Shift Locks)
    // =========================================================================
    match /boarding_logs/{logId} {
      allow read: if isAuthenticated();
      allow write: if isAuthenticated() && (isAdmin() || isDriverOrConductor());
    }

    // =========================================================================
    // ROUTES COLLECTION
    // =========================================================================
    match /routes/{routeId} {
      allow read: if isAuthorizedUser();
      allow write: if isAdmin();
    }

    // =========================================================================
    // BUS FLEET & REAL-TIME LOCATIONS
    // =========================================================================
    match /buses/{busId} {
      allow read: if isAuthorizedUser();
      allow create, delete: if isAdmin();
      allow update: if isAdmin() || (
        isDriverOrConductor() && (
          ('driverEmails' in resource.data && request.auth.token.email in resource.data.driverEmails) ||
          ('conductorEmails' in resource.data && request.auth.token.email in resource.data.conductorEmails) ||
          resource.data.driverEmail == request.auth.token.email ||
          getUserData().assignedBusId == busId
        )
      );
      
      match /boardings/{boardingId} {
        allow read: if isAuthenticated() && (isAdmin() || isDriverOrConductor() || request.auth.token.email == resource.data.studentEmail);
        allow write: if isAuthenticated() && (isAdmin() || isDriverOrConductor());
      }
    }

    // =========================================================================
    // DAILY PASSENGER BOARDINGS
    // =========================================================================
    match /daily_boardings/{boardingId} {
      allow read: if isAuthenticated() && (
        isAdmin() || 
        isDriverOrConductor() || 
        request.auth.token.email == resource.data.studentEmail ||
        request.auth.token.email.lower() == resource.data.studentEmail ||
        request.auth.uid == resource.data.studentId
      );
      allow create: if isAuthenticated() && (
        isAdmin() || 
        isDriverOrConductor() || 
        request.resource.data.studentEmail == request.auth.token.email ||
        request.resource.data.studentEmail == request.auth.token.email.lower() ||
        request.resource.data.studentId == request.auth.uid ||
        request.resource.data.studentId == request.auth.token.email
      );
      allow update, delete: if isAdmin();
      
      match /logs/{studentId} {
        allow read: if isAuthenticated() && (isAdmin() || isDriverOrConductor() || request.auth.token.email == resource.data.studentEmail);
        allow write: if isAuthenticated() && (isAdmin() || isDriverOrConductor());
      }
    }

    match /submitted-boardings/{boardingId} {
      allow read: if isAuthenticated() && (
        isAdmin() || 
        isDriverOrConductor() || 
        request.auth.token.email == resource.data.studentEmail ||
        request.auth.token.email.lower() == resource.data.studentEmail
      );
      allow create: if isAuthenticated() && (isAdmin() || isDriverOrConductor());
      allow update, delete: if isAdmin();
    }

    // =========================================================================
    // NOTIFICATIONS & ALERTS
    // =========================================================================
    match /notifications/{notifId} {
      allow read: if isAuthenticated();
      allow write: if isAdmin() || isDriverOrConductor();
    }

    // =========================================================================
    // LOST & FOUND
    // =========================================================================
    match /lost-items/{itemId} {
      allow read: if isAuthenticated();
      allow create: if isAuthenticated() && (
        request.resource.data.userEmail == request.auth.token.email || 
        request.resource.data.userEmail == request.auth.token.email.lower() ||
        request.resource.data.userId == request.auth.uid ||
        request.resource.data.userId == request.auth.token.email ||
        !('userEmail' in request.resource.data) ||
        request.resource.data.userEmail == "" ||
        isAdmin()
      );
      allow update: if isAdmin() || (
        isAuthenticated() && (
          resource.data.userEmail == request.auth.token.email ||
          resource.data.userEmail == request.auth.token.email.lower() ||
          resource.data.userId == request.auth.uid ||
          resource.data.userId == request.auth.token.email
        )
      );
      allow delete: if isAdmin() || (
        isAuthenticated() && (
          resource.data.userEmail == request.auth.token.email ||
          resource.data.userEmail == request.auth.token.email.lower() ||
          resource.data.userId == request.auth.uid ||
          resource.data.userId == request.auth.token.email
        )
      );
    }

    // =========================================================================
    // SUPPORT TICKETS
    // =========================================================================
    match /support-queries/{queryId} {
      allow read: if isAdmin() || (
        isAuthenticated() && (
          resource.data.studentEmail == request.auth.token.email ||
          resource.data.studentEmail == request.auth.token.email.lower() ||
          resource.data.studentId == request.auth.uid ||
          resource.data.studentId == request.auth.token.email
        )
      );
      allow create: if isAuthenticated() && (
        request.resource.data.studentEmail == request.auth.token.email || 
        request.resource.data.studentEmail == request.auth.token.email.lower() || 
        request.resource.data.studentId == request.auth.uid ||
        request.resource.data.studentId == request.auth.token.email ||
        isAdmin()
      );
      allow update: if isAdmin() || (
        isAuthenticated() && (
          resource.data.studentEmail == request.auth.token.email ||
          resource.data.studentEmail == request.auth.token.email.lower() ||
          resource.data.studentId == request.auth.uid ||
          resource.data.studentId == request.auth.token.email
        )
      );
      allow delete: if isAdmin();
    }

    // =========================================================================
    // TRIPS & SESSIONS
    // =========================================================================
    match /trips/{tripId} {
      allow read: if isAuthorizedUser();
      allow write: if isAdmin() || isDriverOrConductor();
    }

    match /driverSessions/{sessionId} {
      allow read: if isAdmin() || (
        isDriverOrConductor() && 
        resource.data.driverEmail == request.auth.token.email
      );
      allow write: if isAdmin() || (
        isDriverOrConductor() && (
          ('driverEmail' in request.resource.data && request.resource.data.driverEmail == request.auth.token.email) ||
          ('driverEmail' in resource.data && resource.data.driverEmail == request.auth.token.email)
        )
      );
    }

    // =========================================================================
    // TENANT AND SYSTEM SETTINGS
    // =========================================================================
    match /settings/{settingId} {
      allow read: if isAuthenticated();
      allow write: if isAdmin();
    }

    match /sub-institutes/{instId} {
      allow read: if isAuthenticated();
      allow write: if isAdmin();
    }

    match /tenants/{tenantId} {
      allow read: if isAuthenticated();
      allow write: if isAdmin();
    }
  }
}

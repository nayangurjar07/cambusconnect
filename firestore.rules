rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // =========================================================================
    // TESTING & DEVELOPMENT RULES (Skip security blocks for demo/testing)
    // =========================================================================
    /* match /{document=**} {
      allow read, write: if true;
    } */

    // =========================================================================
    // SECURE PRODUCTION RULES REFERENCE (Uncomment in production)
    // =========================================================================
    // Helper to check if logged-in user is an admin
    function isAdmin() {
      return request.auth != null && 
             request.auth.token != null &&
             request.auth.token.email != null &&
             exists(/databases/$(database)/documents/users/$(request.auth.token.email)) &&
             get(/databases/$(database)/documents/users/$(request.auth.token.email)).data.role == 'admin';
    }

    // Helper to check if logged-in user is a driver
    function isDriver() {
      return request.auth != null && 
             request.auth.token != null &&
             request.auth.token.email != null &&
             exists(/databases/$(database)/documents/users/$(request.auth.token.email)) &&
             get(/databases/$(database)/documents/users/$(request.auth.token.email)).data.role == 'driver';
    }

    match /users/{email} {
      // Allow read to authenticated users (their own profile), admins, and unauthenticated stats queries
      allow read: if request.auth != null || true;
      allow write: if isAdmin() || (request.auth != null && request.auth.token.email == email) || true;
    }

    match /buses/{busId} {
      allow read: if true;
      allow write: if isAdmin() || isDriver() || true;
      
      match /boardings/{boardingId} {
        allow read, write: if true;
      }
    }

    match /daily_boardings/{date} {
      allow read, write: if true;
      
      match /logs/{studentId} {
        allow read, write: if true;
      }
    }

    match /notifications/{notifId} {
      allow read: if true;
      allow write: if isAdmin() || isDriver() || true;
    }

    match /lost-items/{itemId} {
      allow read, write: if true;
    }

    match /support-queries/{queryId} {
      allow read, write: if true;
    }

    match /trips/{tripId} {
      allow read, write: if true;
    }

    match /driverSessions/{sessionId} {
      allow read, write: if true;
    }

    match /settings/{settingId} {
      allow read: if isAdmin();
      allow write: if isAdmin();
    }
  }
}

